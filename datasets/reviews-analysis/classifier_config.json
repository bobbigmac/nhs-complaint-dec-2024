{
  "taxonomy_version": "2026-03-16-operational-v1",
  "min_text_len": 20,
  "min_df": 2,
  "max_df": 0.90,
  "dbscan_eps": 0.70,
  "dbscan_min_samples": 2,
  "min_cluster_size": 5,
  "merge_similarity_threshold": 0.20,
